{
  "name": "@eliware/mcp-server-template",
  "type": "module",
  "version": "1.1.0",
  "description": "A Model Context Protocol (MCP) server template for building AI and automation tool APIs.",
  "main": "mcp-server-template.mjs",
  "scripts": {
    "start": "node mcp-server-template.mjs",
    "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
    "test:gaps": "npm test -- --coverageReporters=text 2>&1 | awk '!/100%/'",
    "lint": "npx oxlint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/mcp-server-template.git"
  },
  "keywords": [
    "mcp-server",
    "mcp-server-template",
    "ai-tools",
    "automation",
    "nodejs",
    "template"
  ],
  "author": "Eli Sterling, eliware.org <eli@eliware.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eliware/mcp-server-template/issues"
  },
  "homepage": "https://github.com/eliware/mcp-server-template#readme",
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)",
      "**/?(*.)+(spec|test).mjs",
      "**/?(*.)+(spec|test).cjs"
    ]
  },
  "dependencies": {
    "@eliware/common": "^1.1.5",
    "@eliware/mcp-server": "^1.1.6",
    "dotenv": "^17.4.2"
  }
}
