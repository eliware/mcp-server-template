{
  "name": "@eliware/mcp-server-template",
  "version": "13.0.0",
  "type": "module",
  "description": "A Model Context Protocol (MCP) server template for building AI and automation tool APIs.",
  "keywords": [
    "mcp-server",
    "mcp-server-template",
    "ai-tools",
    "automation",
    "nodejs",
    "template"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./bin/mcp-server-template.mjs",
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^12.0.1",
    "@eliware/mcp-server": "^12.0.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@eliware/test": "^13.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/mcp-server-template.git"
  },
  "homepage": "https://github.com/eliware/mcp-server-template#readme",
  "bugs": {
    "url": "https://github.com/eliware/mcp-server-template/issues"
  },
  "eliware": {
    "id": "E-1040",
    "apply": [
      "general",
      "application",
      "mcp-server",
      "ghcr-published"
    ]
  }
}
